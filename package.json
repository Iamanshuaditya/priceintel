{
  "name": "priceintel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/copy-build-assets.ts",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts packages/*/test/*.test.ts",
    "test:security": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test packages/crawler-core/test/url-policy.test.ts",
    "test:vertical": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/vertical-slice.test.ts",
    "test:integration": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "canary:live": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/reliability-canary.ts",
    "canary:shopify": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/reliability-canary.ts --corpus tests/live-canary/shopify-corpus.json --truth tests/live-canary/shopify-manual-truth.json --output artifacts/reliability/shopify && node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/reliability-economics.ts --input artifacts/reliability/shopify/latest.json --output artifacts/reliability/shopify",
    "fixture": "node --disable-warning=ExperimentalWarning --experimental-strip-types apps/fixture-server/src/main.ts",
    "demo": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/demo-first-slice.ts",
    "db:migrate": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/migrate.ts",
    "api": "node --disable-warning=ExperimentalWarning --experimental-strip-types apps/api/src/main.ts",
    "worker": "node --disable-warning=ExperimentalWarning --experimental-strip-types apps/worker/src/main.ts"
  },
  "dependencies": {
    "bullmq": "6.1.1",
    "ioredis": "5.10.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.0",
    "@types/pg": "8.21.0",
    "typescript": "7.0.2"
  }
}
